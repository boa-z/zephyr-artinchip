# SPDX-License-Identifier: Apache-2.0
if SOC_SERIES_D13X

# This board's E907 CLIC reports CLICINFO=0x00600090, i.e. numint[12:0]=144, so
# the vector and ISR tables cover every slot the controller implements rather
# than the SDK peripheral map's 0..95. tests/kernel re-reads the register.
config NUM_IRQS
	default 144

config SYS_CLOCK_TICKS_PER_SEC
	default 1000

config SYS_CLOCK_HW_CYCLES_PER_SEC
	default $(dt_node_int_prop_int,/cpus,timebase-frequency)

config RISCV_MCAUSE_EXCEPTION_MASK
	default 0xFFF

config ARCH_SW_ISR_TABLE_ALIGN
	default 64

# Legacy driver reads the implemented priority width from CLICINFO.
# Reserve zero bits for interrupt nesting in the initial candidate.
config CLIC_PARAMETER_MNLBITS
	default 0

endif
