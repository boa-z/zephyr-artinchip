config SOC_SERIES_D13X
	select RISCV
	select CPU_XUANTIE_E907
	select SOC_RESET_HOOK
	select LEGACY_CLIC_MEMORYMAP_ACCESS
	select CLIC_LEGACY_MMIO_LAYOUT
	select CLIC_SMCLICCONFIG_EXT
	select CLIC_SMCLICSHV_EXT
	select RISCV_NO_MTVAL_ON_FP_TRAP
	select RISCV_NO_MTVAL_ON_FP_TRAP_UNALIGNED
	select RISCV_SOC_CONTEXT_SAVE

if SOC_SERIES_D13X

config ARTINCHIP_D13X_DIAGNOSTIC_144_IRQS
	bool "Use the observed 144-slot CLIC table for the diagnostic board trial"
	help
	  Experimental opt-in for the board reporting CLICINFO=0x00600090.
	  Covers all reported controller slots with initialized default handlers;
	  does not add peripheral IRQ assignments beyond the SDK's 0..95 map.
	  Leave disabled for the default software candidate.

config ARTINCHIP_D13X_BOOT_CONTRACT
	bool "Build a candidate requiring the documented bootloader handoff"
	help
	  This is a software candidate, not a verified board boot path. The loader
	  must enter in M-mode with SRAM accessible, interrupt delivery disabled,
	  instruction coherency established, and UART0 clock/pins configured.
	  Read docs/bringup/d13x-boot-contract.md before any hardware use.

endif
