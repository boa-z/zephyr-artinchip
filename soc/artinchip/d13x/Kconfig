config SOC_SERIES_D13X
	select RISCV
	select CPU_XUANTIE_E907
	select SOC_RESET_HOOK
	select LEGACY_CLIC_MEMORYMAP_ACCESS
	select CLIC_LEGACY_MMIO_LAYOUT
	select CLIC_SMCLICCONFIG_EXT
	select CLIC_SMCLICSHV_EXT
	select RISCV_NO_MTVAL_ON_FP_TRAP
	select RISCV_NO_MTVAL_ON_FP_TRAP_UNALIGNED
	select RISCV_SOC_CONTEXT_SAVE

if SOC_SERIES_D13X

config ARTINCHIP_D13X_BOOT_CONTRACT
	bool "Acknowledge the documented bootloader handoff"
	help
	  Acknowledgement that the loader must enter in M-mode with the linked
	  SRAM or PSRAM region accessible, interrupt delivery disabled, instruction
	  coherency established, and UART0 clock/pins configured. Compiling the SoC
	  does not require it; scripts/package_candidate.py refuses to collect a
	  build into a hardware candidate without it, so the flag marks intent to
	  run on the board rather than the ability to build.
	  Read docs/bringup/d13x-boot-contract.md before any hardware use.

endif
